# Virtual environments
.venv*/

# Data artifacts are transferred separately and never committed
data/*
!data/.gitkeep
*.csv
*.pkl

# Jupyter and Python service files
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Editor and OS files
.vscode/
.idea/
.DS_Store

# MLflow: commit launch script, keep database and model artifacts locally
mlflow/*
!mlflow/start_mlflow.sh
mlruns/
mlartifacts/
mlruns.db*
backups/
research/.local/
